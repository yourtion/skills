{
  "name": "yourtion-skills",
  "private": true,
  "type": "module",
  "description": "Yourtion 的 Agent Skills 源码与维护工具",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "scaffold": "node scripts/scaffold-skill.mjs",
    "validate": "node scripts/validate-skills.mjs",
    "test": "node --test tests/*.test.mjs skills/*/scripts/*.test.mjs",
    "check": "pnpm test && pnpm validate",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "devDependencies": {
    "semver": "7.8.5",
    "yaml": "2.9.1"
  }
}
